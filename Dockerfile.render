# Stage 1: Build React + Vite frontend (Геологический атлас + 300k GPU particles)
FROM node:20-slim AS web-builder
WORKDIR /build/web_ui
COPY web_ui/package.json web_ui/package-lock.json ./
RUN npm ci
COPY web_ui ./
RUN npm run build

# Stage 2: Lightweight Python FastAPI runtime for Render
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-render.txt /tmp/requirements-render.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements-render.txt && rm -f /tmp/requirements-render.txt

COPY backend ./backend
COPY data/books ./data/books
COPY data/passports ./data/passports
COPY data/domain_packages ./data/domain_packages
COPY --from=web-builder /build/web_ui/dist ./web_ui/dist

RUN mkdir -p /app/outputs && python3 -c "from pathlib import Path; from backend.t3.pipeline import BOOK_CATALOG, build_t3_course_package; [build_t3_course_package(Path('data'), Path('outputs'), bf, render_mp4=False) for bf in BOOK_CATALOG]"

EXPOSE 8000

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
